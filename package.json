{
  "name": "cafefinder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/src/index.ts",
    "build": "prisma generate && vite build && esbuild server/src/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && tsx server/src/scripts/generate-release-manifest.ts",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy:check": "tsx server/src/scripts/deploy-preflight.ts",
    "deploy:verify": "tsx server/src/scripts/verify-deployment.ts",
    "deploy": "tsx server/src/scripts/deploy.ts",
    "rollback": "tsx server/src/scripts/rollback.ts",
    "migration:check": "tsx server/src/scripts/migration-safety.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx server/prisma/seed.ts",
    "scrape:cafes": "tsx server/src/scripts/scrape-cafes.ts",
    "backup:db": "tsx server/src/scripts/run-backup.ts db",
    "backup:uploads": "tsx server/src/scripts/run-backup.ts uploads",
    "backup:all": "tsx server/src/scripts/run-backup.ts all",
    "system:cleanup": "tsx server/src/scripts/cleanup.ts",
    "db:restore-test": "tsx server/src/scripts/restore-test.ts",
    "test:smoke": "tsx server/src/scripts/smoke-test.ts",
    "test": "npm run lint && tsx server/src/scripts/deploy-preflight.ts"
  },
  "prisma": {
    "seed": "tsx server/prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "6.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.30.0",
    "morgan": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "prisma": "6.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mapbox-gl": "^3.5.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
