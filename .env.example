# Database
# For MariaDB, Prisma uses mysql provider
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cafefinder"
DB_USERNAME=
DB_PASSWORD=

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Auth
SESSION_SECRET="your-very-secure-secret-change-in-production"

# Storage
UPLOAD_DIR=./uploads

# Maps
MAP_PROVIDER=google
MAP_API_KEY=
