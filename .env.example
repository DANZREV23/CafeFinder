# Environment Configuration (development | production)
NODE_ENV=development

# Application Port (Internal only, behind Nginx)
PORT=3000

# Database URL (Production PostgreSQL)
# Example: postgresql://user:password@127.0.0.1:5432/cafefinder
DATABASE_URL="postgresql://CAFefinder_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5432/cafefinder"
PRISMA_DATABASE_URL="postgresql://CAFefinder_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5432/cafefinder"

# Public URLs
CLIENT_URL="https://example.com"
PUBLIC_SITE_URL="https://example.com"

# Security
SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Storage
UPLOAD_DIR="/var/www/CafeFinder/shared/uploads"

# Maps
VITE_GOOGLE_MAPS_API_KEY="REPLACE_WITH_KEY"
GOOGLE_MAPS_API_KEY="REPLACE_WITH_KEY"

# Email Configuration
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM_NAME="CafeFinder"
EMAIL_FROM_ADDRESS="noreply@example.com"
EMAIL_REPLY_TO="support@example.com"
EMAIL_BASE_URL="https://example.com"

# Operational Configuration
DEFAULT_LOCALE=en-PH
SUPPORTED_LOCALES=en-PH
DEFAULT_CURRENCY=PHP
APP_TIMEZONE=Asia/Manila
BACKUP_ENABLED=true
BACKUP_DIR="/var/www/CafeFinder/shared/backups"
BACKUP_RETENTION_DAYS=14
BACKUP_COMPRESS=true
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
APP_VERSION=1.0.0
