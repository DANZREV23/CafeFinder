// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CafeStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CafeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  avatarUrl    String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedCafes      Cafe[]           @relation("CafeOwner")
  reviews         CafeReview[]
  favorites       CafeFavorite[]
  claims          CafeOwnerClaim[]
  blogPosts       BlogPost[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  sessions        Session[]
  cafeSubmissions CafeSubmission[] @relation("CafeSubmitter")

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("sessions")
}

model Cafe {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  shortDescription String?    @db.Text
  description      String?    @db.Text
  address          String
  city             String
  state            String
  country          String
  postalCode       String
  latitude         Decimal?   @db.Decimal(10, 7)
  longitude        Decimal?   @db.Decimal(10, 7)
  phone            String?
  email            String?
  website          String?    @db.Text
  instagram        String?    @db.Text
  facebook         String?    @db.Text
  priceRange       Int?       @default(1)
  status           CafeStatus @default(DRAFT)
  verified         Boolean    @default(false)
  featured         Boolean    @default(false)
  trending         Boolean    @default(false)
  ratingAverage    Decimal    @default(0) @db.Decimal(3, 2)
  reviewCount      Int        @default(0)
  ownerId          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  owner       User?            @relation("CafeOwner", fields: [ownerId], references: [id])
  photos      CafePhoto[]
  hours       CafeHours[]
  amenities   CafeAmenity[]
  reviews     CafeReview[]
  favorites   CafeFavorite[]
  claims      CafeOwnerClaim[]
  curatedList CuratedListCafe[]
  submission  CafeSubmission?  @relation("CafeCreatedFrom")

  @@index([status])
  @@index([city])
  @@index([featured])
  @@index([trending])
  @@index([ratingAverage])
  @@index([createdAt])
  @@map("cafes")
}

model CafeSubmission {
  id                      String               @id @default(cuid())
  submittedById           String
  cafeId                  String?              @unique
  name                    String
  shortDescription        String               @db.Text
  description             String               @db.Text
  address                 String
  city                    String
  state                   String?
  country                 String
  postalCode              String?
  latitude                Decimal?             @db.Decimal(10, 7)
  longitude               Decimal?             @db.Decimal(10, 7)
  phone                   String?
  email                   String?
  website                 String?              @db.Text
  instagram               String?              @db.Text
  facebook                String?              @db.Text
  priceRange              Int?                 @default(1)
  status                  CafeSubmissionStatus @default(PENDING)
  rejectionReason         String?              @db.Text
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  submittedBy User                    @relation("CafeSubmitter", fields: [submittedById], references: [id])
  cafe        Cafe?                   @relation("CafeCreatedFrom", fields: [cafeId], references: [id])
  photos      CafeSubmissionPhoto[]
  amenities   CafeSubmissionAmenity[]

  @@index([submittedById])
  @@index([status])
  @@map("cafe_submissions")
}

model CafeSubmissionPhoto {
  id           String   @id @default(cuid())
  submissionId String
  url          String   @db.Text
  caption      String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  submission CafeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("cafe_submission_photos")
}

model CafeSubmissionAmenity {
  submissionId String
  amenityId    String

  submission CafeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  amenity    Amenity        @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([submissionId, amenityId])
  @@map("cafe_submission_amenities")
}

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cafes           CafeAmenity[]
  cafeSubmissions CafeSubmissionAmenity[]

  @@map("amenities")
}

model CafeAmenity {
  cafeId    String
  amenityId String

  cafe    Cafe    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([cafeId, amenityId])
  @@map("cafe_amenities")
}

model CafeHours {
  id        String  @id @default(cuid())
  cafeId    String
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  isClosed  Boolean @default(false)
  openTime  String? // HH:mm
  closeTime String? // HH:mm

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, dayOfWeek])
  @@map("cafe_hours")
}

model CafePhoto {
  id           String   @id @default(cuid())
  cafeId       String
  url          String   @db.Text
  thumbnailUrl String?  @db.Text
  caption      String?  @db.Text
  altText      String?
  sortOrder    Int      @default(0)
  isCover      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@map("cafe_photos")
}

model CafeReview {
  id             String       @id @default(cuid())
  cafeId         String
  userId         String
  coffeeRating   Int?         @default(0)
  ambianceRating Int?         @default(0)
  serviceRating  Int?         @default(0)
  overallRating  Int
  comment        String?      @db.Text
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cafe   Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos CafeReviewPhoto[]

  @@unique([cafeId, userId])
  @@index([cafeId])
  @@index([userId])
  @@index([status])
  @@map("cafe_reviews")
}

model CafeReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  url       String   @db.Text
  caption   String?  @db.Text
  createdAt DateTime @default(now())

  review CafeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("cafe_review_photos")
}

model CafeOwnerClaim {
  id                     String      @id @default(cuid())
  cafeId                 String
  userId                 String
  businessName           String
  verificationInformation String?     @db.Text
  status                 ClaimStatus @default(PENDING)
  submittedAt            DateTime    @default(now())
  reviewedAt             DateTime?
  reviewedBy             String?

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([userId])
  @@index([status])
  @@map("cafe_owner_claims")
}

model CafeFavorite {
  id        String   @id @default(cuid())
  userId    String
  cafeId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([userId, cafeId])
  @@index([userId])
  @@index([cafeId])
  @@index([userId, createdAt])
  @@map("cafe_favorites")
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  content     String     @db.Text
  coverImage  String?    @db.Text
  authorId    String
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model CuratedList {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  coverImage  String?  @db.Text
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cafes CuratedListCafe[]

  @@map("curated_lists")
}

model CuratedListCafe {
  listId    String
  cafeId    String
  sortOrder Int    @default(0)

  list CuratedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  cafe Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([listId, cafeId])
  @@map("curated_list_cafes")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  avatarUrl String?  @db.Text
  content   String   @db.Text
  rating    Int      @default(5)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
