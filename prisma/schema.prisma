generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("PRISMA_DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  avatar        String?
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cafes         Cafe[]
  reviews       CafeReview[]
  ownerClaims   CafeOwnerClaim[]
  favorites     CafeFavorite[]
  blogPosts     BlogPost[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([email])
}

model Cafe {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String    @db.Text
  shortDescription String?   @db.VarChar(255)
  address          String
  city             String
  state            String
  country          String
  postalCode       String
  latitude         Float
  longitude        Float
  phone            String?
  email            String?
  website          String?
  instagram        String?
  facebook         String?
  priceRange       Int       @default(1) // 1 to 4
  status           String    @default("ACTIVE")
  verified         Boolean   @default(false)
  featured         Boolean   @default(false)
  trending         Boolean   @default(false)
  ratingAverage    Float     @default(0)
  reviewCount      Int       @default(0)
  ownerId          String?
  owner            User?     @relation(fields: [ownerId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  photos           CafePhoto[]
  amenities        CafeAmenity[]
  hours            CafeHours[]
  reviews          CafeReview[]
  ownerClaims      CafeOwnerClaim[]
  favorites        CafeFavorite[]
  curatedLists     CuratedListCafe[]

  @@index([slug])
  @@index([city])
  @@index([status])
  @@index([verified])
  @@index([featured])
  @@index([trending])
  @@index([ratingAverage])
  @@index([latitude, longitude])
}

model CafePhoto {
  id           String   @id @default(cuid())
  cafeId       String
  cafe         Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  caption      String?
  altText      String?
  sortOrder    Int      @default(0)
  isCover      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([cafeId])
}

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., FAST_WIFI, PET_FRIENDLY
  label       String   // e.g., Fast Wi-Fi, Pet Friendly
  icon        String?
  cafes       CafeAmenity[]
}

model CafeAmenity {
  cafeId      String
  amenityId   String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([cafeId, amenityId])
  @@index([cafeId])
  @@index([amenityId])
}

model CafeHours {
  id         String   @id @default(cuid())
  cafeId     String
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0-6 (Sunday-Saturday)
  isClosed   Boolean  @default(false)
  openTime   String?  // HH:mm
  closeTime  String?  // HH:mm
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cafeId, dayOfWeek])
  @@index([cafeId])
}

model CafeReview {
  id                 String   @id @default(cuid())
  userId             String
  cafeId             String
  user               User     @relation(fields: [userId], references: [id])
  cafe               Cafe     @relation(fields: [cafeId], references: [id])
  ratingCoffee       Int
  ratingAmbiance     Int
  ratingService      Int
  ratingOverall      Int
  comment            String   @db.Text
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  photos             CafeReviewPhoto[]

  @@index([cafeId])
  @@index([userId])
}

model CafeReviewPhoto {
  id           String     @id @default(cuid())
  reviewId     String
  review       CafeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url          String
  createdAt    DateTime   @default(now())

  @@index([reviewId])
}

model CafeOwnerClaim {
  id                     String   @id @default(cuid())
  cafeId                 String
  userId                 String
  cafe                   Cafe     @relation(fields: [cafeId], references: [id])
  user                   User     @relation(fields: [userId], references: [id])
  businessName           String
  verificationInformation String   @db.Text
  status                 String   @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedAt            DateTime @default(now())
  reviewedAt             DateTime?
  reviewedById           String?

  @@index([status])
  @@index([cafeId])
  @@index([userId])
}

model CafeFavorite {
  userId    String
  cafeId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  cafe      Cafe     @relation(fields: [cafeId], references: [id])

  @@id([userId, cafeId])
  @@index([userId])
  @@index([cafeId])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  content     String   @db.LongText
  coverImage  String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model CuratedList {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cafes       CuratedListCafe[]

  @@index([slug])
}

model CuratedListCafe {
  listId    String
  cafeId    String
  sortOrder Int      @default(0)
  list      CuratedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  cafe      Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([listId, cafeId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  avatar    String?
  content   String   @db.Text
  rating    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
}
